# ᑲყᥣx — cache policy
# HTML must always revalidate so new markup rolls out immediately.
#
# styles.css and script.js are only entry points: their @import / import
# specifiers are separate requests carrying no ?v=, so bumping the entry
# point's version never reached css/*.css or js/*.js — they sat in
# Hostinger's long cache indefinitely. That is what shipped stale styling.
# Rather than version ~17 specifiers by hand on every deploy, the partials
# revalidate: ETags make the unchanged ones cheap 304s.
# That strategy is load-bearing, so state the ETag policy rather than relying
# on Apache's default.
FileETag MTime Size

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# One hostname. www.bylx.dev was serving the whole site with a 200 — every page
# and the sitemap — so the site existed at two addresses. The canonical tags on
# each page already pointed at the apex, so Google would have consolidated them
# eventually, but a redirect says it in one hop instead of asking a crawler to
# work it out. Measured 2026-09-23, the day the domain property was verified:
# both hostnames answered 200.
#
# Anchored to "^www\." on purpose: other subdomains (yogurt.bylx.dev) are their
# own sites and must not be caught by this.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
  # The machine shipped at /arcade/purikura/ and was renamed to the name it
  # actually goes by. That path was public and listed in the sitemap, so it
  # redirects rather than 404s — a renamed URL that dies throws away whatever
  # the old one earned.
  RewriteRule ^arcade/purikura/?$ /arcade/cutegal/ [R=301,L]
</IfModule>

# 404.html existed but nothing pointed Apache at it, so Apache served its own
# default error page instead.
ErrorDocument 404 /404.html

# The repo deploys whole, so everything in it is reachable over HTTP unless it
# is denied here. Verified served with 200 before this block: /CLAUDE.md,
# /DESIGN.md, /package.json, /playwright.config.js, /bylx.design-system.json,
# /tests/*.spec.js. CLAUDE.md in particular documents internal decisions.
<FilesMatch "\.(md|json|mjs|spec\.js|lock)$">
  Require all denied
</FilesMatch>

# The design-system kit: 2.3MB of spec that is not part of the site.
<Files "bylx.dev - Standalone.html">
  Require all denied
</Files>

<IfModule mod_alias.c>
  RedirectMatch 404 "^/(tests|scripts|node_modules|emails)/"
</IfModule>
